          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Bucket01",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Bucket01.Arn}/*"
                }
