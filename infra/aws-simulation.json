  "Description": "Argus synthetic-only activity lab: 6 machine roles, 7 private fixture buckets. No app/model deployment.",
  "Parameters": {
    "TrailName": {
      "Type": "String",
      "Default": "argus-ueba-live-trail",
      "AllowedPattern": "argus-[a-z0-9-]+"
