# Leave blank to use SQLite (local dev). Set to Neon/Supabase URL for production.
DATABASE_URL=
DATA_DIR=./data/processed
DEMO_DIR=./demo
DEMO_MODE=false
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI investigation suggestions — Ensemble mode: set ANY combination below.
# All configured providers are queried in parallel; results are synthesised
# into one authoritative plan when >=2 providers succeed.
#
# GEMINI_API_KEY     — https://aistudio.google.com/apikey   (free, no card)
# OPENROUTER_API_KEY — https://openrouter.ai/keys           (free models: Llama-3.3, Gemini-Flash, DeepSeek-V3)
# DEEPSEEK_API_KEY   — https://platform.deepseek.com        (free credits on sign-up)
# GROQ_API_KEY       — https://console.groq.com             (free tier, fastest)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
