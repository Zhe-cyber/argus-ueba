{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeTheOneEventQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:us-east-1:<ACCOUNT_ID>:<QUEUE_NAME>"
    },
    {
      "Sid": "ReadTheMigrationPackOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<MIGRATION_BUCKET>/migrate/<PACK_ID>/*"
    }
  ]
}
